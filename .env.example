# App
NEXT_PUBLIC_APP_NAME="Portal DK Gestao"

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Finance
FINANCE_PROVIDER=conta_azul
CONTA_AZUL_BASE_URL=https://api-v2.contaazul.com
CONTA_AZUL_AUTH_URL=https://auth.contaazul.com/login
CONTA_AZUL_TOKEN_URL=https://auth.contaazul.com/oauth2/token
CONTA_AZUL_CLIENT_ID=
CONTA_AZUL_CLIENT_SECRET=
CONTA_AZUL_REDIRECT_URI=http://localhost:3000/api/integrations/conta-azul/callback

# Asaas (conta de pagamentos / BaaS)
# ATENÇÃO: a chave começa com "$". No .env.local é preciso escapar
# (ASAAS_API_KEY=\$aact_...), senão o Next trata como variável e ela vira
# undefined — o sintoma é 401 em toda chamada. Na Vercel NÃO escapar.
ASAAS_ENV=sandbox
ASAAS_API_KEY=
# Token que o Asaas devolve no header a cada webhook de PAGAMENTO.
ASAAS_WEBHOOK_TOKEN=
# Token do webhook de VALIDAÇÃO DE SAQUE, que é outro (configurado em
# Integrações > Segurança > Validação de saque via Webhook). Sem ele, o
# endpoint recusa toda saída de dinheiro por segurança.
ASAAS_SAQUE_TOKEN=

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google-calendar/callback

# Pina (integração de coreografias/formações)
PINA_APP_URL=https://www.pinaform.app
PINA_ALLOWED_ORIGIN=https://www.pinaform.app
# JSON inteiro do service account do Firebase "pinaform-a5fec" (uma linha).
# NUNCA commitar o valor real — só em env/secret manager (Vercel) e .env.local.
FIREBASE_SERVICE_ACCOUNT=

# Nome comercial da plataforma. Enquanto o naming não sai (fase 5 da direção
# de identidade), a interface mostra o valor daqui. Vazio cai em "Plataforma".
NEXT_PUBLIC_PLATFORM_NAME=""
NEXT_PUBLIC_PLATFORM_TAGLINE=""

# ── E-mail ────────────────────────────────────────────────────────────────
# SEM a chave, nada é enviado: o código registra no log e segue. É o que
# torna seguro subir o envio antes de o domínio estar verificado.
RESEND_API_KEY=
# Remetente. O domínio precisa estar verificado no provedor (SPF + DKIM).
EMAIL_REMETENTE="SouAle <contato@souale.com.br>"
# Desvia TODO e-mail para um endereço só, com o destinatário real no assunto.
# Deixe preenchido enquanto testa — com ela ligada nenhuma escola recebe nada.
EMAIL_REDIRECT_TO=
